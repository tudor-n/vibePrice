# Copy to .env for local development. Never commit .env.

POSTGRES_DB=pricepilot
POSTGRES_USER=pricepilot
POSTGRES_PASSWORD=devpassword
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Backend
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__Default=Host=db;Port=5432;Database=pricepilot;Username=pricepilot;Password=devpassword
# Must be at least 32 UTF-8 bytes (256 bits, HS256 minimum) — the API refuses to start otherwise.
JWT_SIGNING_KEY=dev-only-change-me-32-chars-minimum!!
# Apply EF migrations on boot (compose sets this true for the api service)
DATABASE_MIGRATE_ON_STARTUP=true
# Seed the demo tenant from shared/contracts/demo-seed.md (Development only)
DEMO_SEED_ON_STARTUP=true
# Reverse proxy support — REQUIRED when the API runs behind a reverse proxy (e.g. Caddy
# on the VPS), otherwise the per-IP login rate limiter sees only the proxy's IP (one
# shared bucket for everyone). Forwarded headers are never trusted unless Enabled=true
# AND the proxy is listed in KnownProxies (comma-separated IPs) and/or KnownNetworks
# (comma-separated CIDR, e.g. 172.18.0.0/16 for a compose network).
ForwardedHeaders__Enabled=false
ForwardedHeaders__KnownProxies=
ForwardedHeaders__KnownNetworks=

# Dataplane
DATABASE_URL=postgresql+psycopg://pricepilot:devpassword@db:5432/pricepilot
# Honest-bot UA by default. Booking.com may block obvious bots; operators can
# override with a browser UA at their own ToS judgment — scraping stays
# deliberately polite either way (see SCRAPE_DELAY_SECONDS + ADR 0004).
SCRAPER_USER_AGENT=Mozilla/5.0 (compatible; PricePilotBot/0.1)
SCRAPER_PROXY_URL=
SCHEDULER_ENABLED=true
# Scraping (ADR 0004): one city-search request per stay date per source.
SCRAPE_SOURCES=booking
SCRAPE_DAYS_AHEAD=90
SCRAPE_DELAY_SECONDS=4.0
SCRAPE_TIMEOUT_SECONDS=20.0
SCRAPE_CURRENCY=RON
# Places (Google Places API): property/competitor geocoding + auto-discovery.
# "fixture" (default) never calls Google — it reads saved JSON packaged at
# dataplane/src/pricepilot/places/fixtures/, safe for local dev/CI with no billing.
# Set to "google" + provide GOOGLE_PLACES_API_KEY to enable live lookups.
PLACES_PROVIDER=fixture
GOOGLE_PLACES_API_KEY=
COMPETITOR_DISCOVERY_RADIUS_M=1500
COMPETITOR_DISCOVERY_MAX=15
# Cards considered per competitor when resolving its Booking listing link.
COMPETITOR_LINK_MAX_RESULTS=10

# Web (Vite build-time)
VITE_API_BASE_URL=http://localhost:8080/api/v1
